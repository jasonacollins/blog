# Generated by Hugo from the current pages; manual rules are in the source _redirects file.
{{- $top := where site.RegularPages "Section" "" }}
{{- $topNames := slice }}
{{- range $top }}{{ $topNames = $topNames | append .File.ContentBaseName }}{{ end }}
{{- range where site.RegularPages "Section" "posts" }}
{{- $n := .File.ContentBaseName }}
{{- if not (in $topNames $n) }}
/{{ $n }} /posts/{{ $n }} 301
/{{ $n }}/ /posts/{{ $n }} 301
{{- end }}
{{- end }}
{{- range $top }}
/{{ .File.ContentBaseName }}/ /{{ .File.ContentBaseName }} 301
{{- end }}
{{- with resources.Get "manual-redirects.txt" }}
{{- range split .Content "\n" }}{{ if and (strings.TrimSpace .) (not (hasPrefix (strings.TrimSpace .) "#")) }}
{{ . }}
{{- end }}{{ end }}
{{- end }}
